# Daily brief — keys. These go in ~/.claude/.env (one KEY=VALUE per line).

# Required. Free tier at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Only if the brief should land in Telegram (from /telegram-command-bot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
# TELEGRAM_DAILY_BRIEF_TOPIC_ID=

# Optional tuning
# BRIEF_PRESET=small_team          # solo | small_team | agency
# BRIEF_MODEL=gemini-2.5-flash
# DB_PATH=data/workspace.db        # where the numbers live (default: first .db under data/)
# AIOS_WORKSPACE=/path/to/project  # default: the folder you run from
