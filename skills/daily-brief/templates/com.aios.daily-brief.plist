<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aios.daily-brief</string>

    <!-- Replace __PYTHON__ with the python that has the requirements installed,
         and __WORKSPACE__ with the absolute path of the project folder. -->
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__HOME__/.claude/skills/daily-brief/scripts/daily_brief.py</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>__WORKSPACE__</string>

    <key>StandardOutPath</key>
    <string>__WORKSPACE__/data/daily-brief.log</string>
    <key>StandardErrorPath</key>
    <string>__WORKSPACE__/data/daily-brief.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
</dict>
</plist>
