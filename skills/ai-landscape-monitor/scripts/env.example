# AI landscape monitor — keys. These go in ~/.claude/.env (one KEY=VALUE per line).
#
# Nothing is required. The leaderboards are public pages.

# Optional. Free account at https://openrouter.ai — adds pricing and context length.
# OPENROUTER_API_KEY=sk-or-v1-...

# Optional tuning
# DB_PATH=data/workspace.db        # where scans are stored (default: first .db under data/)
# AIOS_WORKSPACE=/path/to/project  # default: the folder you run from
