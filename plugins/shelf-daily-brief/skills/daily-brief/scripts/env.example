# Daily brief — keys. These go in ~/.claude/.env (one KEY=VALUE per line).
#
# Any ONE of these. The first one present is used, in this order.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional tuning
# BRIEF_MODEL=                     # override the model name for the provider picked
# BRIEF_PRESET=small_team          # solo | small_team | agency
# DB_PATH=data/workspace.db        # where the numbers live (default: first .db under data/)
# AIOS_WORKSPACE=/path/to/project  # default: the folder you run from
