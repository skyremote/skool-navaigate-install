# Content pipeline — keys. These go in ~/.claude/.env (one KEY=VALUE per line).
#
# Nothing is required. The pipeline is a local SQLite file plus markdown.

# Optional: a team-visible calendar in Notion.
# Internal integration at https://www.notion.so/my-integrations (read, update, insert content).
# NOTION_API_TOKEN=
# Set after: python3 ~/.claude/skills/content-pipeline/scripts/notion_sync.py --create-db PAGE_ID
# NOTION_PIPELINE_DB_ID=

# Optional tuning
# AIOS_WORKSPACE=/path/to/project  # default: the folder you run from
