[
  {
    "name": "01_install-aios",
    "commands": [
      "claude plugin marketplace add ./",
      "claude plugin install aios@navaigate-aios"
    ]
  },
  {
    "name": "02_install-brain",
    "commands": [
      "claude plugin install aios-brain@navaigate-aios"
    ]
  },
  {
    "name": "03_install-aios-codex-cursor",
    "commands": [
      "./install.sh aios"
    ]
  },
  {
    "name": "04_install-brain-codex-cursor",
    "commands": [
      "./install.sh aios-brain",
      "export PATH=\"$HOME/.local/bin:$PATH\""
    ]
  },
  {
    "name": "05_init-brain",
    "commands": [
      "brain init"
    ]
  },
  {
    "name": "06_prepare-demo-sessions",
    "commands": [
      "python3 scripts/sandbox_fixtures_v1.py --home /tmp/aios-member-sandbox"
    ]
  },
  {
    "name": "07_capture-sessions",
    "commands": [
      "brain capture"
    ]
  },
  {
    "name": "08_repeat-capture",
    "commands": [
      "brain capture"
    ]
  },
  {
    "name": "09_search-memory",
    "commands": [
      "brain search 'Lighthouse budget'"
    ]
  },
  {
    "name": "10_read-memory",
    "commands": [
      "brain read claude:e97b4107125b:fictional-claude"
    ]
  },
  {
    "name": "11_check-health",
    "commands": [
      "brain status"
    ]
  },
  {
    "name": "12_verify-claude-code",
    "commands": [
      "claude plugin list"
    ]
  },
  {
    "name": "13_verify-codex",
    "commands": [
      "codex mcp list"
    ]
  },
  {
    "name": "14_verify-cursor-config",
    "commands": [
      "cat \"$HOME/.cursor/mcp.json\""
    ]
  },
  {
    "name": "15_check-all-harnesses",
    "commands": [
      "python3 plugins/aios/scripts/status.py | more"
    ]
  }
]
