[
  {
    "name": "01_install-aios_v2",
    "commands": [
      "claude plugin marketplace add ./",
      "claude plugin install aios@navaigate-aios"
    ]
  },
  {
    "name": "02_install-brain_v2",
    "commands": [
      "claude plugin install aios-brain@navaigate-aios"
    ]
  },
  {
    "name": "03_install-aios-codex-cursor_v2",
    "commands": [
      "./install.sh aios"
    ]
  },
  {
    "name": "04_install-brain-codex-cursor_v2",
    "commands": [
      "./install.sh aios-brain",
      "export PATH=\"$HOME/.local/bin:$PATH\""
    ]
  },
  {
    "name": "05_init-brain_v2",
    "commands": [
      "brain init"
    ]
  },
  {
    "name": "06_prepare-demo-sessions_v2",
    "commands": [
      "python3 scripts/sandbox_fixtures_v1.py --home /tmp/aios-member-sandbox"
    ]
  },
  {
    "name": "07_capture-sessions_v2",
    "commands": [
      "brain capture"
    ]
  },
  {
    "name": "08_repeat-capture_v2",
    "commands": [
      "brain capture"
    ]
  },
  {
    "name": "09_search-memory_v2",
    "commands": [
      "brain search 'Lighthouse budget'"
    ]
  },
  {
    "name": "10_read-memory_v2",
    "commands": [
      "brain read claude:0458a6348e43:fictional-claude"
    ]
  },
  {
    "name": "11_check-health_v2",
    "commands": [
      "brain status | more"
    ]
  },
  {
    "name": "12_verify-claude-code_v2",
    "commands": [
      "claude plugin list"
    ]
  },
  {
    "name": "13_verify-codex_v2",
    "commands": [
      "codex mcp list"
    ]
  },
  {
    "name": "14_verify-cursor-config_v2",
    "commands": [
      "cat \"$HOME/.cursor/mcp.json\""
    ]
  },
  {
    "name": "15_check-all-harnesses_v2",
    "commands": [
      "python3 plugins/aios/scripts/status.py | more"
    ]
  }
]
